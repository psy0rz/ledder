  {
    "id": "1edde4a0c5b7e102",
    "type": "function",
    "z": "1edde4a0c5b7e101",
    "name": "build text json",
    "func": "//Builds the message for the \"text\" command of the ledder MQTT animation.\n//msg.payload is the text. An empty payload (or msg.remove = true) removes the text.\n//msg.removeAll = true removes all texts, of every id.\n//Every property of this node can be overridden per message: msg.x = 5 wins over the X property.\n\nconst property = (name) => msg[name] !== undefined ? msg[name] : env.get(name)\n\nconst baseTopic = property(\"baseTopic\")\n\nif (msg.removeAll === true) {\n    msg.topic = `${baseTopic}/text`\n    msg.payload = \"\"\n    node.status({fill: \"grey\", shape: \"ring\", text: \"removed all\"})\n    return msg\n}\n\nconst textId = property(\"textId\")\nif (textId === undefined || textId === \"\") {\n    node.error(\"Text id missing\", msg)\n    return null\n}\n\nmsg.topic = `${baseTopic}/text/${textId}`\n\nconst text = msg.payload === undefined || msg.payload === null ? \"\" : String(msg.payload)\nif (text === \"\" || msg.remove === true) {\n    msg.payload = \"\"\n    node.status({fill: \"grey\", shape: \"ring\", text: \"removed\"})\n    return msg\n}\n\nconst textParameters = {\n    text: text,\n    x: Number(property(\"x\")),\n    y: Number(property(\"y\")),\n    font: property(\"font\"),\n    color: property(\"color\"),\n    scale: Number(property(\"scale\")),\n    hAlign: property(\"hAlign\"),\n    vAlign: property(\"vAlign\"),\n}\n\n//0 means: dont wrap\nconst wrapWidth = Number(property(\"wrapWidth\"))\nif (wrapWidth > 0)\n    textParameters.wrapWidth = wrapWidth\n\n//0 means: dont blink, a blinkOff of 0 means: same as blinkOn\nif (property(\"blink\") === true) {\n    const blinkOn = Number(property(\"blinkOn\"))\n    const blinkOff = Number(property(\"blinkOff\"))\n    if (blinkOn > 0) {\n        textParameters.blinkOn = blinkOn\n        if (blinkOff > 0)\n            textParameters.blinkOff = blinkOff\n    }\n}\n\nmsg.payload = JSON.stringify(textParameters)\nnode.status({fill: \"green\", shape: \"dot\", text: text.length > 20 ? text.substring(0, 20) + \"...\" : text})\nreturn msg\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
